# Modèle entièrement fictif ; remplacer URL/clé par celles de la recette locale.
# La clé TEST_ONLY_FAKE_KEY permet le build, pas une connexion Auth réelle.
# ─── General ─────────────────────────────────────────────────────────────
# URL publique canonique utilisée pour les redirections email en production.
# Laisser vide en local pour utiliser l'origine courante.
EXPO_PUBLIC_APP_URL=http://127.0.0.1:4173/app

# Chemin public de la PWA. Le build combiné utilise /app ; le build Cloudflare
# dédié force automatiquement cette valeur à /.
EXPO_PUBLIC_APP_BASE_PATH=/app

# Email de contact public pour les createurs et partenaires.
EXPO_PUBLIC_CREATOR_CONTACT_EMAIL=demo@example.invalid

# Contact affiche dans les diagnostics et metadonnees de build PWA.
EXPO_PUBLIC_SUPPORT_CONTACT=demo@example.invalid

# Endpoint same-origin optionnel recevant les evenements techniques PWA anonymises.
EXPO_PUBLIC_PWA_ANALYTICS_ENDPOINT=

# Canal explicite optionnel: development, preview ou production.
EXPO_PUBLIC_RELEASE_CHANNEL=development


# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Créer sur https://console.cloud.google.com/apis/credentials
# Voir docs/auth/EPIC2-google-oauth.md pour le guide complet

# iOS Client ID (type "iOS" dans Google Cloud Console)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Android Client ID (type "Android")
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# Web Client ID (type "Application Web") — optionnel tant que Google OAuth n'est pas actif
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Environnement applicatif exposé côté client (development, preview, production)
EXPO_PUBLIC_APP_ENV=development


# ─── Supabase ─────────────────────────────────────────────────────────────────
# Créer sur https://supabase.com → Dashboard → Settings → API
# Voir docs/sql/EPIC3-supabase.md pour le guide complet

# URL du projet Supabase
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Clé publique anon (ne jamais utiliser service_role côté client)
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_TEST_ONLY_FAKE_KEY
