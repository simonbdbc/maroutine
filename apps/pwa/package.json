{
  "name": "@maroutine/pwa",
  "version": "2.1.2",
  "appVersion": "2.1.2",
  "main": "expo-router/entry",
  "scripts": {
    "start": "npx expo start",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "sync:stickers:public": "node ./scripts/sync-public-stickers.cjs",
    "lint:stickers:pages": "node ./scripts/check-stickers-pages.cjs",
    "lint:colors": "node ./scripts/check-inline-colors.cjs",
    "lint:contrast": "node ./scripts/check-theme-contrast.cjs",
    "lint:theme:contract": "node ./scripts/check-theme-contract.cjs",
    "lint:theme:shell": "node ./scripts/check-theme-shell.cjs",
    "lint:tokens:legacy": "node ./scripts/check-legacy-theme-tokens.cjs",
    "lint:tokens:legacy:strict": "node ./scripts/check-legacy-theme-tokens.cjs --strict",
    "qa:theme": "node ./scripts/check-inline-colors.cjs && node ./scripts/check-theme-contract.cjs && node ./scripts/check-theme-contrast.cjs && node ./scripts/check-theme-shell.cjs && node ./scripts/check-legacy-theme-tokens.cjs --strict",
    "web:env:check": "node ./scripts/check-web-env.cjs",
    "web:serve:dist": "node ./scripts/serve-dist.mjs",
    "validate:pwa": "node ./scripts/validate-pwa.mjs",
    "pwa:contract:test": "node --test ./scripts/pwa-lifecycle-contract.test.mjs",
    "e2e:pwa": "playwright test tests/e2e/pwa.spec.ts",
    "e2e:pwa:build": "npm run web:build && npm run validate:pwa && npm run e2e:pwa",
    "tsc": "tsc --noEmit",
    "test:e8-r09": "tsc -p tsconfig.e8-r09.json && node -r ./tests/register-node-assets.cjs dist/e8-r09-tests/tests/e8-r09/run.js",
    "test:e9-r11": "tsc -p tsconfig.e9-r11.json && node -r ./tests/register-node-assets.cjs dist/e9-r11-tests/tests/e9-r11/run.js",
    "test:e11-t04": "tsc -p tsconfig.e11-t04.json && node dist/e11-t04-tests/tests/e11-t04/run.js",
    "test:e11-t12": "tsc -p tsconfig.e11-t12.json && node dist/e11-t12-tests/tests/e11-t12/run.js",
    "test:e11-t13": "tsc -p tsconfig.e11-t13.json && node dist/e11-t13-tests/tests/e11-t13/run.js",
    "test:e11-t16": "tsc -p tsconfig.e11-t16.json && node dist/e11-t16-tests/tests/e11-t16/run.js",
    "test:e11-t17": "tsc -p tsconfig.e11-t17.json && node dist/e11-t17-tests/tests/e11-t17/run.js",
    "test:e13-t07": "tsc -p tsconfig.e13-t07.json && node dist/e13-t07-tests/tests/e13-t07/run.js",
    "test:e15-t04": "tsc -p tsconfig.e15-t04.json && node dist/e15-t04-tests/tests/e15-t04/run.js",
    "test:e16-rewards-history": "tsc -p tsconfig.e16-rewards-history.json && node dist/e16-rewards-history-tests/tests/e16-rewards-history/run.js",
    "test:e18-t06": "tsc -p tsconfig.e18-t06.json && node dist/e18-t06-tests/tests/e18-t06/run.js",
    "lint": "node ./scripts/check-inline-colors.cjs && node ./scripts/check-theme-contrast.cjs && ESLINT_USE_FLAT_CONFIG=false eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\"",
    "web:build": "node ./scripts/sync-public-stickers.cjs && node ./scripts/check-stickers-pages.cjs && node ./scripts/check-inline-colors.cjs && node ./scripts/check-theme-contract.cjs && node ./scripts/check-theme-contrast.cjs && node ./scripts/check-theme-shell.cjs && node ./scripts/check-web-env.cjs && CI=1 NODE_ENV=production EXPO_NO_TELEMETRY=1 npx expo export --platform web --output-dir dist --clear && node ./scripts/post-export-web.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.2.3",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@supabase/supabase-js": "^2.49.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~54.0.35",
    "expo-auth-session": "~7.0.11",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "nativewind": "^4.0.36",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@playwright/test": "^1.55.0",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~54.0.11",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "postcss": "8.5.10",
    "uuid": "11.1.1"
  },
  "private": true,
  "engines": {
    "node": ">=20.19.5"
  }
}
