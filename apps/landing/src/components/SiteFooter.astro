---
import { siteConfig } from "../config/site.config";
---

<footer class="site-footer">
  <div class="page-shell site-footer__inner">
    <div class="site-footer__brand">
      <a class="brand" href="/" aria-label="Maroutine, accueil">
        <span class="brand__name">Maroutine</span>
        <span class="brand__star" aria-hidden="true">★</span>
      </a>
      <p>Des routines quotidiennes plus sereines pour toute la famille.</p>
    </div>
    <nav aria-label="Liens de l’application">
      <a href={siteConfig.app.homePath}>Application</a>
      <a href={siteConfig.app.loginPath}>Connexion</a>
    </nav>
  </div>
</footer>
