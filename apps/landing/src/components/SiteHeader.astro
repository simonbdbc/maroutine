---
import { siteConfig } from "../config/site.config";
---

<header class="site-header">
  <div class="site-header__inner page-shell">
    <a class="brand" href="/" aria-label="Maroutine, accueil">
      <span class="brand__name">Maroutine</span>
      <span class="brand__star" aria-hidden="true">★</span>
    </a>

    <nav class="site-nav" aria-label="Navigation principale">
      {siteConfig.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a class="button button--small button--primary site-header__cta" href={siteConfig.app.loginPath}>
      {siteConfig.cta.secondary}
    </a>
  </div>
</header>
